{
  "name": "@civicpulse/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/http.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "set -a; [ ! -f ../../.env ] || . ../../.env; set +a; if [ -z \"$TEST_DATABASE_URL\" ] || [ \"${TEST_DATABASE_URL##*/}\" != 'civicpulse_test' ]; then echo 'BLOCKED: TEST_DATABASE_URL must point to the dedicated civicpulse_test PostgreSQL/PostGIS database.' >&2; exit 1; fi; DATABASE_URL=\"$TEST_DATABASE_URL\" RUN_INTEGRATION=1 npm run db:migrate && DATABASE_URL=\"$TEST_DATABASE_URL\" RUN_INTEGRATION=1 SMTP_HOST= SMTP_USER= SMTP_PASS= EMAIL_FROM= vitest run src/integration",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:status": "tsx src/db/migrate.ts --status",
    "start:api": "node dist/http.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@civicpulse/shared": "*",
    "@google/genai": "^1.0.0",
    "argon2": "^0.41.1",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "graphile-worker": "^0.16.6",
    "helmet": "^8.0.0",
    "nodemailer": "^10.0.3",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

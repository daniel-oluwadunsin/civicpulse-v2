# Server only
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://civicpulse:civicpulse@localhost:5432/civicpulse
# Keep true when the database CA is trusted. Some managed providers require false for their private TLS certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
TEST_DATABASE_URL=postgresql://civicpulse:civicpulse@localhost:5432/civicpulse_test
WEB_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
SESSION_COOKIE_NAME=civicpulse_session
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_DAYS=30
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_EVIDENCE_FOLDER=civicpulse/evidence
# Add one or more server-only Gemini keys. The server rotates only after a rate-limit response.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL_REPORT_ANALYSIS=gemini-3.5-flash-lite
GEMINI_MODEL_MATCHING=gemini-3.5-flash-lite
GEMINI_MODEL_ROUTING=gemini-3.5-flash-lite
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Gmail address and a Google app password; never use the normal account password.
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CivicPulse <your-address@gmail.com>
GEOAPIFY_API_KEY=

# Browser-safe only
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_GEOAPIFY_API_KEY=
